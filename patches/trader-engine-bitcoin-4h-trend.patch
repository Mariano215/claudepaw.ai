+def run_crypto_4h_trend_backtest(
+    data_client,
+    periods: int = 10_950,
+    slippage_bps: float = 10.0,
+    fee_bps: float = 25.0,
+) -> BacktestResult:
+    """Simulate the frozen BTC/USD four-hour trend candidate after costs."""
+    from trader_engine.signals.crypto_trend_4h import (
+        BASKET,
+        HORIZON_DAYS,
+        MIN_BARS,
+        MIN_SCORE,
+        STRATEGY_NAME,
+        _trend_score,
+    )
+
+    warnings: list[str] = []
+    all_trades: list[Trade] = []
+    start_date = ''
+    end_date = ''
+    for asset in BASKET:
+        try:
+            df = data_client.get_four_hour_bars(asset, periods=periods)
+        except Exception as exc:
+            warnings.append(f'{asset}: four-hour bar fetch failed ({exc})')
+            continue
+        if len(df) <= MIN_BARS + 2:
+            warnings.append(f'{asset}: only {len(df)} bars, needs > {MIN_BARS + 2}')
+            continue
+        start_date = str(df.index[0])
+        end_date = str(df.index[-1])
+        all_trades.extend(_simulate_asset(
+            asset=asset,
+            df=df,
+            score_fn=_trend_score,
+            min_score=MIN_SCORE,
+            horizon_days=HORIZON_DAYS,
+            slippage_bps=slippage_bps,
+            fee_bps=fee_bps,
+            warmup=MIN_BARS,
+            bars_per_day=6,
+            vol_window_bars=35 * 6,
+        ))
+
+    returns = [trade.return_net for trade in all_trades]
+    total_return = 1.0
+    for value in returns:
+        total_return *= 1.0 + value
+    total_return -= 1.0
+    wins = sum(value > 0 for value in returns)
+    unresolved = sum(trade.reason == 'eod' for trade in all_trades)
+    if unresolved:
+        warnings.append(f'{unresolved} trade(s) open at history end, marked to last close')
+    return BacktestResult(
+        strategy=STRATEGY_NAME,
+        method=(
+            'fixed BTC/USD 4h breakout plus EMA trend and explicit cost hurdle; '
+            'completed signal bar, next-4h-open entry, stop-before-target, seven-day '
+            'time stop, conservative crypto fee and slippage on both legs; no fit'
+        ),
+        start=start_date,
+        end=end_date,
+        n_trades=len(all_trades),
+        sharpe=_sharpe_per_trade(returns),
+        max_drawdown=_max_drawdown(returns) if returns else None,
+        win_rate=(wins / len(returns)) if returns else None,
+        expectancy=statistics.fmean(returns) if returns else None,
+        total_return=total_return,
+        slippage_bps=slippage_bps,
+        fee_bps=fee_bps,
+        min_score=MIN_SCORE,
+        sharpe_convention=(
+            'mean/stdev of per-trade returns annualised by sqrt(252), matching '
+            'the live cohort gate; not a conventional time-series Sharpe'
+        ),
+        assets=list(BASKET), warnings=warnings, trades=all_trades,
+    )
