+"""BTC/USD four-hour trend breakout with an explicit cost hurdle."""
+from __future__ import annotations
+
+import math
+import time
+from dataclasses import dataclass
+from typing import Any
+
+import pandas as pd
+import structlog
+
+logger = structlog.get_logger()
+
+STRATEGY_NAME = 'trend-4h-crypto'
+BASKET: tuple[str, ...] = ('BTC/USD',)
+FAST_EMA = 20
+SLOW_EMA = 100
+BREAKOUT_BARS = 20
+RETURN_BARS = 6
+SLOPE_BARS = 6
+MIN_RETURN = 0.014
+MIN_SCORE = 0.05
+HORIZON_DAYS = 7
+MIN_BARS = SLOW_EMA + SLOPE_BARS + 2
+SCORE_BARS = MIN_BARS + 30
+
+
+def _trend_score(df: pd.DataFrame) -> float:
+    """Score a completed four-hour bar without future information."""
+    if len(df) < MIN_BARS:
+        return 0.0
+    # Production fetches SCORE_BARS. Pin history here so a backtest does not
+    # get a differently initialised EMA merely because more old bars exist.
+    df = df.tail(SCORE_BARS)
+    closes = df['close'].astype(float)
+    highs = df['high'].astype(float)
+    last_close = float(closes.iloc[-1])
+    prior_high = float(highs.iloc[-(BREAKOUT_BARS + 1):-1].max())
+    ret_24h = last_close / float(closes.iloc[-(RETURN_BARS + 1)]) - 1.0
+    fast = closes.ewm(span=FAST_EMA, adjust=False).mean()
+    slow = closes.ewm(span=SLOW_EMA, adjust=False).mean()
+    fast_now = float(fast.iloc[-1])
+    slow_now = float(slow.iloc[-1])
+    slow_prior = float(slow.iloc[-(SLOPE_BARS + 1)])
+    if (
+        prior_high <= 0
+        or last_close <= prior_high
+        or ret_24h <= MIN_RETURN
+        or fast_now <= slow_now
+        or slow_now <= slow_prior
+    ):
+        return 0.0
+    breakout = last_close / prior_high - 1.0
+    trend_spread = fast_now / slow_now - 1.0
+    excess_return = ret_24h - MIN_RETURN
+    combined = 0.4 * breakout + 0.3 * trend_spread + 0.3 * excess_return
+    return float(math.tanh(combined * 10.0))
+
+
+@dataclass
+class ScoredAsset:
+    asset: str
+    strategy: str
+    raw_score: float
+    ts_ms: int
+
+
+def score_all(data_client: Any) -> list[ScoredAsset]:
+    """Return a score for each frozen asset; errors fail closed to zero."""
+    now_ms = int(time.time() * 1000)
+    results: list[ScoredAsset] = []
+    for asset in BASKET:
+        try:
+            df = data_client.get_four_hour_bars(asset, periods=SCORE_BARS)
+            score = _trend_score(df)
+        except Exception as exc:
+            logger.warning('crypto_trend_4h.skip', asset=asset, error=str(exc))
+            score = 0.0
+        results.append(ScoredAsset(asset, STRATEGY_NAME, score, now_ms))
+    return results
