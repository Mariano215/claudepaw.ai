+from __future__ import annotations
+
+import pandas as pd
+
+from trader_engine.signals.crypto_trend_4h import (
+    MIN_BARS,
+    MIN_RETURN,
+    STRATEGY_NAME,
+    _trend_score,
+    score_all,
+)
+
+
+def _frame(closes: list[float]) -> pd.DataFrame:
+    index = pd.date_range('2025-01-01', periods=len(closes), freq='4h', tz='UTC')
+    return pd.DataFrame({
+        'open': closes, 'high': [v * 1.001 for v in closes],
+        'low': [v * 0.999 for v in closes], 'close': closes,
+        'volume': [10] * len(closes),
+    }, index=index)
+
+
+def test_trend_score_fires_only_for_aligned_cost_clearing_breakout():
+    closes = [100 + i * 0.12 for i in range(MIN_BARS)]
+    closes.extend([closes[-1] * (1 + MIN_RETURN / 6)] * 5)
+    closes.append(max(closes) * 1.025)
+    assert _trend_score(_frame(closes)) > 0.05
+
+
+def test_trend_score_rejects_flat_market():
+    assert _trend_score(_frame([100.0] * (MIN_BARS + 10))) == 0.0
+
+
+def test_score_all_is_btc_only_and_fails_closed():
+    class Client:
+        def get_four_hour_bars(self, asset, periods):
+            raise RuntimeError('down')
+
+    result = score_all(Client())
+    assert len(result) == 1
+    assert result[0].asset == 'BTC/USD'
+    assert result[0].strategy == STRATEGY_NAME
+    assert result[0].raw_score == 0.0
