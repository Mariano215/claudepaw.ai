+@pytest.mark.asyncio
+async def test_terminal_broker_state_promotes_fresher_live_local_row(session, adapter):
+    """Terminal broker truth closes a stale live row even when its timestamp
+    predates the local write. This repairs legacy placed/partial rows whose
+    stored timestamp was advanced after Alpaca had already closed the order.
+    """
+    t_fresh = int(time.time() * 1000)
+    t_terminal = t_fresh - 10_000
+    _seed_order_at(
+        session, "coid-terminal", "placed", "b-terminal",
+        filled_qty=0.0, filled_avg_price=None, updated_at=t_fresh,
+    )
+    terminal_bo = BrokerOrder(
+        client_order_id="coid-terminal", broker_order_id="b-terminal",
+        asset="SPY", side="buy", qty=1.0, order_type="limit",
+        limit_price=100.0, status="canceled", filled_qty=0.0,
+        filled_avg_price=None, source="alpaca",
+        created_at=t_terminal, updated_at=t_terminal,
+    )
+    adapter.get_orders.side_effect = (
+        lambda **kw: [terminal_bo] if kw["status"] == "closed" else []
+    )
+
+    from trader_engine.execution.order_reconciler import reconcile_orders
+    await reconcile_orders(session, adapter)
+
+    row = session.execute(text(
+        "SELECT status,updated_at FROM engine_orders "
+        "WHERE client_order_id='coid-terminal'"
+    )).one()
+    assert row.status == "canceled"
+    assert row.updated_at == t_terminal
 
 
