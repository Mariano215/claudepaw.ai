 @pytest.mark.asyncio
+async def test_covered_short_absent_at_broker_zeroes_row(session, mock_adapter):
+    """A filled buy closes a negative local quantity when the broker no longer
+    lists the asset. This prevents a completed paper repair from remaining as
+    a stale short in GET /positions.
+    """
+    now_ms = int(time.time() * 1000)
+    session.add(EnginePosition(
+        asset="IWM", qty=-3.0, avg_entry_price=294.16,
+        market_value=-882.48, unrealized_pnl=0.0,
+        source="alpaca", updated_at=now_ms,
+    ))
+    session.add(_order("IWM", "sell", 3.0, now_ms - 1_000_000))
+    session.add(_order("IWM", "buy", 3.0, now_ms - 1_000))
+    session.commit()
+    mock_adapter.get_positions.return_value = []
+
+    from trader_engine.execution.reconciler import Reconciler
+    result = await Reconciler(session=session, adapter=mock_adapter).run()
+
+    assert result.drift_detected is False
+    session.expire_all()
+    row = session.get(EnginePosition, "IWM")
+    assert row.qty == 0.0
+    assert row.market_value == 0.0
+    assert row.unrealized_pnl == 0.0
+
+
