+"""Tests for the frozen BTC/USD hourly pullback rule."""
+from __future__ import annotations
+
+from unittest.mock import MagicMock
+
+import pandas as pd
+
+from trader_engine.signals.crypto_mean_reversion import (
+    BASKET,
+    HORIZON_DAYS,
+    STRATEGY_NAME,
+    _mean_reversion_score,
+    generate_candidates,
+    score_all,
+)
+
+
+def _hourly(closes: list[float]) -> pd.DataFrame:
+    idx = pd.date_range('2025-01-01', periods=len(closes), freq='h', tz='UTC')
+    return pd.DataFrame({
+        'open': closes,
+        'high': [c * 1.002 for c in closes],
+        'low': [c * 0.998 for c in closes],
+        'close': closes,
+        'volume': [10.0] * len(closes),
+    }, index=idx)
+
+
+def _uptrend_pullback() -> pd.DataFrame:
+    trend = [100 + i * 0.25 for i in range(220)]
+    pullback = [trend[-1] - i * 0.55 for i in range(1, 19)]
+    return _hourly(trend + pullback)
+
+
+def test_hourly_pullback_scores_positive_above_long_trend():
+    score = _mean_reversion_score(_uptrend_pullback())
+    assert 0 < score <= 1
+
+
+def test_downtrend_is_rejected_even_when_rsi_is_oversold():
+    closes = [200 - i * 0.25 for i in range(230)]
+    assert _mean_reversion_score(_hourly(closes)) == 0
+
+
+def test_generator_is_bitcoin_only_and_uses_one_day_horizon():
+    client = MagicMock()
+    client.get_hourly_bars.return_value = _uptrend_pullback()
+    candidates = generate_candidates(client)
+    assert BASKET == ('BTC/USD',)
