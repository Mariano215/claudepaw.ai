+@router.post("/orders/{client_order_id}/cancel", response_model=CancelOrderOut)
+async def cancel_order(
+    client_order_id: str,
+    session: Any = Depends(_session_dep),
+) -> CancelOrderOut:
+    """Idempotently request cancellation for one durable engine order."""
+    order = session.get(EngineOrder, client_order_id)
+    if order is None:
+        raise HTTPException(status_code=404, detail="order not found")
+
+    status = str(order.status or "unknown").lower()
+    if status in _TERMINAL_ORDER_STATUSES:
+        return CancelOrderOut(
+            client_order_id=order.client_order_id,
+            status=status,
+            submitted=False,
+        )
+    if not order.broker_order_id:
+        raise HTTPException(status_code=409, detail="order has no broker id; reconcile before cancellation")
+    if order.source != "alpaca":
+        raise HTTPException(status_code=409, detail="order broker is not available for cancellation")
+
+    try:
+        submitted = await _get_adapter().cancel_order(broker_order_id=order.broker_order_id)
+    except Exception:
+        raise HTTPException(status_code=502, detail="broker cancellation failed") from None
+
+    if not submitted:
+        return CancelOrderOut(
+            client_order_id=order.client_order_id,
+            status=status,
+            submitted=False,
+        )
+
+    # The broker accepted the request. Final canceled/filled state arrives via
+    # trade_updates or reconciliation, so persist the in-flight state now.
+    order.status = "pending_cancel"
+    order.updated_at = int(time.time() * 1000)
+    session.commit()
+    return CancelOrderOut(
+        client_order_id=order.client_order_id,
+        status=order.status,
+        submitted=True,
+    )
