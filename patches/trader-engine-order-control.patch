+def test_orders_filters_open_before_pagination(client_seeded, seeded):
+    order = seeded.query(EngineOrder).filter(EngineOrder.asset == "AAPL").one()
+    order.status = "pending_cancel"
+    seeded.commit()
+    open_response = client_seeded.get("/orders?status=open&limit=1", headers=HEADERS)
+    closed_response = client_seeded.get("/orders?status=closed&limit=1", headers=HEADERS)
+    assert open_response.status_code == 200
+    assert [row["client_order_id"] for row in open_response.json()] == [order.client_order_id]
+    assert closed_response.status_code == 200
+    assert closed_response.json() == []
+
+
+def test_cancel_order_marks_request_pending_and_is_idempotent_after_terminal(client_seeded, seeded, monkeypatch):
+    import trader_engine.api.routes.orders as ord_mod
+
+    order = seeded.query(EngineOrder).filter(EngineOrder.asset == "AAPL").one()
+    order.status = "accepted"
+    seeded.commit()
+
+    class Adapter:
+        calls = []
+
+        async def cancel_order(self, *, broker_order_id):
+            self.calls.append(broker_order_id)
+            return True
+
+    adapter = Adapter()
+    monkeypatch.setattr(ord_mod, "_get_adapter", lambda: adapter)
+    response = client_seeded.post(f"/orders/{order.client_order_id}/cancel", headers=HEADERS)
+    assert response.status_code == 200
+    assert response.json() == {
+        "client_order_id": order.client_order_id,
+        "status": "pending_cancel",
+        "submitted": True,
+    }
+    assert adapter.calls == ["alpaca-xyz"]
+    seeded.refresh(order)
+    assert order.status == "pending_cancel"
+
+    order.status = "canceled"
+    seeded.commit()
+    again = client_seeded.post(f"/orders/{order.client_order_id}/cancel", headers=HEADERS)
+    assert again.status_code == 200
+    assert again.json()["submitted"] is False
+    assert again.json()["status"] == "canceled"
+    assert adapter.calls == ["alpaca-xyz"]
+
+
+def test_cancel_order_rejects_missing_unknown_or_wrong_broker(client_seeded, seeded, monkeypatch):
+    import trader_engine.api.routes.orders as ord_mod
+
+    class Adapter:
+        async def cancel_order(self, *, broker_order_id):
+            raise AssertionError("adapter must not be called")
+
+    monkeypatch.setattr(ord_mod, "_get_adapter", lambda: Adapter())
+    assert client_seeded.post("/orders/missing/cancel", headers=HEADERS).status_code == 404
+
+    order = seeded.query(EngineOrder).filter(EngineOrder.asset == "AAPL").one()
+    order.status = "accepted"
+    order.broker_order_id = None
+    seeded.commit()
+    response = client_seeded.post(f"/orders/{order.client_order_id}/cancel", headers=HEADERS)
+    assert response.status_code == 409
+
+    order.broker_order_id = "coinbase-order"
+    order.source = "coinbase"
+    seeded.commit()
+    response = client_seeded.post(f"/orders/{order.client_order_id}/cancel", headers=HEADERS)
+    assert response.status_code == 409
+
+
+def test_cancel_order_masks_adapter_failures(client_seeded, seeded, monkeypatch):
+    import trader_engine.api.routes.orders as ord_mod
+
+    order = seeded.query(EngineOrder).filter(EngineOrder.asset == "AAPL").one()
+    order.status = "accepted"
+    seeded.commit()
+
+    class Adapter:
+        async def cancel_order(self, *, broker_order_id):
+            raise RuntimeError("broker secret detail")
+
+    monkeypatch.setattr(ord_mod, "_get_adapter", lambda: Adapter())
+    response = client_seeded.post(f"/orders/{order.client_order_id}/cancel", headers=HEADERS)
+    assert response.status_code == 502
+    assert response.json() == {"detail": "broker cancellation failed"}
+    seeded.refresh(order)
+    assert order.status == "accepted"
+
