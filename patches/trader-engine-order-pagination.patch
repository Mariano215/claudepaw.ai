+def test_orders_supports_deterministic_pagination(client_seeded, seeded):
+    now_ms = int(time.time() * 1000)
+    seeded.add(EngineOrder(
+        client_order_id="older-order", broker_order_id="older-broker",
+        decision_id="older-decision", asset="SPY", side="buy", qty=1,
+        order_type="limit", limit_price=500, status="filled", filled_qty=1,
+        filled_avg_price=500, source="alpaca",
+        created_at=now_ms - 1000, updated_at=now_ms - 1000,
+    ))
+    seeded.commit()
+
+    first = client_seeded.get("/orders?limit=1&offset=0", headers=HEADERS)
+    second = client_seeded.get("/orders?limit=1&offset=1", headers=HEADERS)
+    assert first.status_code == 200
+    assert second.status_code == 200
+    assert len(first.json()) == 1
+    assert len(second.json()) == 1
+    assert first.json()[0]["client_order_id"] != second.json()[0]["client_order_id"]
+
+
