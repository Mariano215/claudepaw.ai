+def run_crypto_momentum_backtest(
+    data_client,
+    days: int = 1_825,
+    slippage_bps: float = 10.0,
+    fee_bps: float = 25.0,
+) -> BacktestResult:
+    """Simulate the deployed BTC-only daily breakout rule after costs."""
+    from trader_engine.signals.crypto_momentum import (
+        BASKET,
+        HORIZON_DAYS,
+        MIN_BARS,
+        MIN_SCORE,
+        STRATEGY_NAME,
+        _breakout_score,
+    )
+
+    warnings: list[str] = []
+    all_trades: list[Trade] = []
+    start_date = ''
+    end_date = ''
+    for asset in BASKET:
+        try:
+            df = data_client.get_daily_bars(asset, days=days)
+        except Exception as exc:
+            warnings.append(f'{asset}: daily bar fetch failed ({exc})')
+            continue
+        if len(df) <= MIN_BARS + 2:
+            warnings.append(
+                f'{asset}: only {len(df)} bars, needs > {MIN_BARS + 2} for a signal'
+            )
+            continue
+        start_date = str(df.index[0])
+        end_date = str(df.index[-1])
+        all_trades.extend(_simulate_asset(
+            asset=asset,
+            df=df,
+            score_fn=_breakout_score,
+            min_score=MIN_SCORE,
+            horizon_days=HORIZON_DAYS,
+            slippage_bps=slippage_bps,
+            fee_bps=fee_bps,
+            warmup=MIN_BARS,
+        ))
+
+    returns = [trade.return_net for trade in all_trades]
+    total_return = 1.0
+    for value in returns:
+        total_return *= 1.0 + value
+    total_return -= 1.0
+    wins = sum(value > 0 for value in returns)
+    unresolved = sum(trade.reason == 'eod' for trade in all_trades)
+    if unresolved:
+        warnings.append(f'{unresolved} trade(s) open at history end, marked to last close')
+
+    return BacktestResult(
+        strategy=STRATEGY_NAME,
+        method=(
+            'historical simulation of the deployed BTC-only breakout; '
+            'completed daily signal, next-day-open entry, stop-before-target, '
+            '14-day time stop, conservative crypto fee and slippage on both legs; '
+            'no parameter fit'
+        ),
+        start=start_date,
+        end=end_date,
+        n_trades=len(all_trades),
+        sharpe=_sharpe_per_trade(returns),
+        max_drawdown=_max_drawdown(returns) if returns else None,
+        win_rate=(wins / len(returns)) if returns else None,
+        expectancy=statistics.fmean(returns) if returns else None,
+        total_return=total_return,
+        slippage_bps=slippage_bps,
+        fee_bps=fee_bps,
+        min_score=MIN_SCORE,
+        sharpe_convention=(
+            'mean/stdev of per-trade returns annualised by sqrt(252), matching '
+            'the live cohort gate; not a conventional daily-return Sharpe'
+        ),
+        assets=list(BASKET),
+        warnings=warnings,
+        trades=all_trades,
+    )
