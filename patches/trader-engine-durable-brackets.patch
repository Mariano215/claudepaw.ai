+@pytest.mark.asyncio
+async def test_stale_unfilled_equity_entry_is_canceled(session, adapter):
+    _seed_order(session, "stale-entry", "new", broker_id="b-stale")
+    old = int(time.time() * 1000) - (31 * 60 * 1000)
+    session.execute(text(
+        "UPDATE engine_orders SET created_at=:old WHERE client_order_id='stale-entry'"
+    ), {"old": old})
+    session.commit()
+    broker = _broker_order("stale-entry", "new", "b-stale", 0.0, None)
+    adapter.get_orders.side_effect = lambda **kw: [broker] if kw["status"] == "open" else []
+    adapter.cancel_order = AsyncMock(return_value=True)
+
+    from trader_engine.execution.order_reconciler import reconcile_orders
+    result = await reconcile_orders(session, adapter)
+
+    adapter.cancel_order.assert_awaited_once_with(broker_order_id="b-stale")
+    assert result.stale_entries_canceled == 1
+    assert session.execute(text(
+        "SELECT status FROM engine_orders WHERE client_order_id='stale-entry'"
+    )).scalar() == "pending_cancel"
+
+
