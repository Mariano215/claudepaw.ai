+@router.post("/positions/{asset}/cover-paper-short", response_model=CoverPaperShortOut)
+async def cover_paper_short(
+    asset: str,
+    session: Any = Depends(_session_dep),
+) -> CoverPaperShortOut:
+    """Idempotently buy to cover one unexpected Alpaca paper short.
+
+    The caller keeps normal entries blocked until broker quantity reaches zero.
+    Persisting the repair intent before submission plus returning an existing
+    live repair order prevents duplicate covers after retries or transport loss.
+    """
+    symbol = asset.strip().upper()
+    if not _EQUITY_SYMBOL.fullmatch(symbol):
+        raise HTTPException(status_code=422, detail="invalid equity symbol")
+    if not settings.alpaca_paper:
+        raise HTTPException(status_code=403, detail="automatic short covering is paper-only")
+
+    adapter = _get_adapter()
+    broker_positions = await adapter.get_positions()
+    position = next((p for p in broker_positions if p.asset.upper() == symbol), None)
+    prior_qty = float(position.qty) if position is not None else 0.0
+    if prior_qty >= -1e-9:
+        return CoverPaperShortOut(
+            asset=symbol, prior_qty=prior_qty, client_order_id=None,
+            broker_order_id=None, status="already_flat", submitted=False,
+        )
+
+    existing = (
+        session.query(EngineOrder)
+        .filter(
+            EngineOrder.asset == symbol,
+            EngineOrder.side == "buy",
+            EngineOrder.source == "auto-repair",
+            EngineOrder.status.in_(_LIVE_ORDER_STATUSES),
+        )
+        .order_by(EngineOrder.created_at.desc())
+        .first()
+    )
+    if existing is not None:
+        return CoverPaperShortOut(
+            asset=symbol, prior_qty=prior_qty,
+            client_order_id=existing.client_order_id,
+            broker_order_id=existing.broker_order_id,
+            status=existing.status, submitted=False,
+        )
+
+    now_ms = int(time.time() * 1000)
+    client_order_id = f"repair-cover-{uuid.uuid4().hex[:24]}"
+    qty = abs(prior_qty)
+    row = EngineOrder(
+        client_order_id=client_order_id,
+        broker_order_id=None,
+        decision_id=client_order_id,
+        asset=symbol,
+        side="buy",
+        qty=qty,
+        order_type="market",
+        limit_price=None,
+        status="pending",
+        filled_qty=0.0,
+        filled_avg_price=None,
+        source="auto-repair",
+        created_at=now_ms,
+        updated_at=now_ms,
+    )
+    session.add(row)
+    session.commit()
+
+    try:
+        broker_order = await adapter.place_order(
+            client_order_id=client_order_id,
+            asset=symbol,
+            side="buy",
+            qty=qty,
+            order_type="market",
+        )
+    except Exception as exc:
+        row.status = "unknown"
+        row.updated_at = int(time.time() * 1000)
+        session.commit()
+        raise HTTPException(status_code=503, detail="paper short-cover submission uncertain") from exc
+
+    row.broker_order_id = broker_order.broker_order_id
+    row.status = broker_order.status
+    row.filled_qty = float(broker_order.filled_qty or 0)
+    row.filled_avg_price = broker_order.filled_avg_price
+    row.updated_at = broker_order.updated_at or int(time.time() * 1000)
+    session.commit()
+    return CoverPaperShortOut(
+        asset=symbol, prior_qty=prior_qty,
+        client_order_id=client_order_id,
+        broker_order_id=broker_order.broker_order_id,
+        status=broker_order.status,
+        submitted=True,
+    )
 
 
